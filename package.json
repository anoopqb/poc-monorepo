{
  "name": "micro-sites-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:site": "ts-node scripts/build-site.ts",
    "build:all": "ts-node scripts/build-all.ts",
    "build:floorplans": "ts-node scripts/build-floorplans.ts",
    "build:floorplans:all": "ts-node scripts/build-floorplans.ts --all",
    "watch:floorplans": "ts-node scripts/watch-floorplans.ts",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "rm -rf dist && turbo run clean",
    "serve:dist": "npx serve dist -l 3000"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "serve": "^14.0.0",
    "ts-node": "^10.9.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@9.0.0"
}