{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "out/**"]
    },
    "main-app#build": {
      "dependsOn": ["main-app#copy-build"]
    },
    "copy-build": {
      "dependsOn": ["small-app#build"],
      "outputs": ["public/small-app/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
